# .env.example
# ClashFree - Environment Variables
# Copy this file to .env and insert your real Supabase credentials.

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# Server-side Supabase key only. Never put this value in frontend variables.
# The current API has no authenticated user/college membership layer; do not
# expose a service-role key to an internet-facing deployment until that exists.
SUPABASE_KEY=your_server_side_supabase_key_here

# 3. Server Port
PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=16777216

# Optional frontend build-time API base; production default is same-origin /api.
# VITE_API_BASE_URL=http://127.0.0.1:5000/api

