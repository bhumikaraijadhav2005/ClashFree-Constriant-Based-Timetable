# .env.example
# ClashFree - Environment Variables
# Copy this file to .env and insert your real Supabase credentials.

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# 2. Supabase Anon / Service Role Key
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. Server Port
PORT=5000

